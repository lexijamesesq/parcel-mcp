{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parcel-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-06",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "cache_option_enabled"
  ],
  "workers_dev": false,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "traces": {
      "enabled": false
    }
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    },
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_YOUR_OAUTH_KV_NAMESPACE_ID"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMIT",
      "namespace_id": "1",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PARCEL_ACCOUNT",
        "class_name": "ParcelAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ParcelAccount"
      ]
    }
  ]
}
